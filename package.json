{
  "name": "diaconato-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "start:hml": "ng serve --host 0.0.0.0 --configuration staging",
    "start:prod": "ng serve --host 0.0.0.0 --configuration production",
    "build": "ng build",
    "build:hml": "ng build --configuration staging",
    "build:prod": "ng build --configuration production",
    "build:gh-pages": "ng build --configuration production --base-href /diaconato/ && node -e \"require('fs').copyFileSync('dist/diaconato-web/browser/index.html', 'dist/diaconato-web/browser/404.html')\"",
    "build:gh-pages:hml": "ng build --configuration staging --base-href /diaconato-hml/ && node -e \"require('fs').copyFileSync('dist/diaconato-web/browser/index.html', 'dist/diaconato-web/browser/404.html')\"",
    "deploy": "npm run build:gh-pages && gh-pages -d dist/diaconato-web/browser",
    "deploy:hml": "npm run build:gh-pages:hml && gh-pages -d dist/diaconato-web/browser -r https://github.com/adtaguatinga/diaconato-hml.git",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}